# Copy this file to .env.development (or .env.local) and fill in your values.
# NEVER commit real secrets to version control.

# API
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# App
VITE_APP_NAME=Ienerz
VITE_APP_VERSION=1.0.0

# Auth
VITE_AUTH_TOKEN_KEY=app_access_token
VITE_AUTH_REFRESH_TOKEN_KEY=app_refresh_token

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
